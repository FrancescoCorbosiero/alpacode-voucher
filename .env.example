# ------------------------------------------------------------
# Alpacode · Segnala un amico — environment
# Copy to .env and fill in. Nothing here is required to run the
# landing locally: without AWS_REGION the API logs every message
# instead of emailing it, so the whole flow is testable offline.
# ------------------------------------------------------------

# Public origin of the landing. Used at BUILD time (canonicals, og:url, the
# QR code) and at RUN time by the API to build invite links
# (<SITE_URL>/invito/MARIO-7K2QX). Set it before `docker compose up --build`.
SITE_URL=https://voucher.alpacode.it

# Domain Caddy routes to this container (caddy-docker-proxy labels).
# Point its DNS A/AAAA record at the VPS first.
SITE_DOMAIN=voucher.alpacode.it

# Secret for referral codes: the 5-char suffix is an HMAC of the referrer's
# email, so the same email always gets the same link. Use a long random
# value (e.g. `openssl rand -hex 32`) and don't change it afterwards —
# a new secret means new codes for everyone (old links keep working).
REFERRAL_SECRET=

# Ledger of every accepted submission (one JSON per line). It powers the
# "already referred" check and the referrer lookup on invite requests.
# docker-compose mounts a volume at /app/data. Set to "off" to disable.
REFERRAL_LEDGER=/app/data/referrals.jsonl

# Also email referrers their personal link (needs SES out of the sandbox,
# since recipients are arbitrary addresses). 1 = on.
REFERRAL_CONFIRM_EMAILS=0

# --- Email via AWS SES (same setup as alpacode.it's contact form) ---
# Region where the sender identity is verified, e.g. eu-west-1.
AWS_REGION=
# IAM ACCESS KEYS with ses:SendEmail (not SES "SMTP credentials").
# Leave empty if the host provides an IAM role.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Studio inbox that receives referrals, and the verified sender.
CONTACT_TO_EMAIL=info@alpacode.it
CONTACT_FROM_EMAIL=info@alpacode.it
