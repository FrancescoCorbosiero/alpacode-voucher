---
import type { Lang } from "../i18n/types";
import { privacy } from "../data/privacy";
import { localizePath } from "../i18n/utils";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = privacy[lang];
---

<div class="rf rf-legal">
  <div class="wrap">
    <header class="rf-legal-head">
      <p class="sec-num" data-intro style="--intro-d:0.02s">{c.kicker}</p>
      <h1 class="intro-lines"><span class="line"><span>{c.h1}</span></span></h1>
      <span class="bar" aria-hidden="true"></span>
      <p data-intro style="--intro-d:0.4s">{c.lede}</p>
      <p class="rf-legal-updated" data-intro style="--intro-d:0.5s">{c.updated}</p>
    </header>
    <div class="rf-legal-body">
      {
        c.sections.map((s) => (
          <section class="rf-legal-section">
            <h2>{s.h}</h2>
            <div set:html={s.body} />
          </section>
        ))
      }
    </div>
    <a class="btn btn-ghost rf-legal-back" href={localizePath("", lang)}>← {c.back}</a>
  </div>
</div>
