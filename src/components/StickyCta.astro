---
/* Sticky CTA pill — appears once the hero is gone, steps aside while
   anything marked [data-sticky-hide] is on screen: the form (and after the
   form has done its job), the finale that repeats the same call, the
   footer's fine print. */
interface Props {
  label: string;
  href: string;
}
const { label, href } = Astro.props;
---

<div class="rf-sticky" data-sticky>
  <a class="rf-sticky-btn" href={href}>{label} <span class="arrow" aria-hidden="true">→</span></a>
</div>

<script>
  const sticky = document.querySelector<HTMLElement>("[data-sticky]");
  const hero = document.querySelector<HTMLElement>("[data-hero]");
  const targets = document.querySelectorAll<HTMLElement>("[data-sticky-hide]");
  if (sticky && hero) {
    let pastHero = false;
    const onScreen = new Set<Element>();
    const apply = () => sticky.classList.toggle("is-visible", pastHero && onScreen.size === 0);
    new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => (pastHero = !e.isIntersecting));
        apply();
      },
      { rootMargin: "-80px 0px 0px 0px" },
    ).observe(hero);
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => (e.isIntersecting ? onScreen.add(e.target) : onScreen.delete(e.target)));
        apply();
      },
      { threshold: 0.12 },
    );
    targets.forEach((t) => io.observe(t));
  }
</script>
