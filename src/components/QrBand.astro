---
/* The flyer's dark QR band: "Scansiona il QR code …", "oppure visita
   alpacode.it/", the alpaca and the handwritten campaign line. On the
   web the QR opens this very page (handy to carry on from a phone, or to
   show to someone across the table); once a personal link exists the
   script swaps in a QR of the invite itself. */
import type { Lang } from "../i18n/types";
import { landing } from "../data/landing";
import { shared } from "../data/shared";
import { business, websiteLinks } from "../data/business";
import { localizePath } from "../i18n/utils";
import { qrSvg } from "../lib/qr";
import Icon from "./Icon.astro";
import Alpaca from "./Alpaca.astro";
import HandLine from "./HandLine.astro";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = landing[lang].qr;
const site = (Astro.site?.href ?? "https://voucher.alpacode.it/").replace(/\/$/, "");
const target = `${site}${localizePath("", lang)}#segnala`;
const svg = qrSvg(target, { label: c.qrAlt });
---

<section class="rf-qr-sec" aria-labelledby="qr-title">
  <div class="wrap-wide">
    <div class="rf-qr-band" data-qr-band>
      <div class="rf-qr-tile" data-qr-tile set:html={svg} />
      <div class="rf-qr-copy">
        <h2 class="rf-qr-title" id="qr-title" data-qr-title>{c.title}</h2>
        <p class="rf-qr-body" data-qr-body>{c.body}</p>
        <p class="rf-qr-hint">{c.hint}</p>
        <p class="rf-qr-visit">
          <Icon name="link" size={20} />
          <span>{c.visit}</span>
          <a class="rf-qr-pill" href={websiteLinks.home[lang]}>
            {business.websiteLabel}/ <span class="arrow" aria-hidden="true">→</span>
          </a>
        </p>
      </div>
      <div class="rf-qr-sign" aria-hidden="true">
        <Alpaca class="rf-qr-alpaca" width={92} />
        <HandLine lines={shared[lang].campaignLine} />
      </div>
    </div>
  </div>
</section>
