---
/* Line icons, drawn for this page — not a stock set. 24px grid,
   1.75 stroke, square caps and mitred joins (the brand has no round
   corners). They inherit currentColor. */
import type { IconName } from "../data/shared";

interface Props {
  name: IconName;
  size?: number;
  class?: string;
  /** Accessible name; omitted = decorative. */
  label?: string;
}
const { name, size = 24, class: cls, label } = Astro.props;

const paths: Record<IconName, string> = {
  // Temple-front bank: pediment, four columns, base.
  bank: '<path d="M3 9.5 12 4l9 5.5"/><path d="M4 9.5h16"/><path d="M6 12v6M10 12v6M14 12v6M18 12v6"/><path d="M3.5 20.5h17"/>',
  // Wallet with a card slot.
  wallet:
    '<path d="M4 7.5h14.5v12H4z"/><path d="M4 7.5 15 4l1 3.5"/><path d="M13.5 12h7v4h-7z"/><path d="M16 14h.01"/>',
  // Gift box with ribbon.
  gift: '<path d="M4 10h16v10.5H4z"/><path d="M3 6.5h18V10H3z"/><path d="M12 6.5v14"/><path d="M12 6.5C10 3 7 3.5 7.5 5.5c.4 1.4 2.6 1 4.5 1Z"/><path d="M12 6.5c2-3.5 5-3 4.5-1-.4 1.4-2.6 1-4.5 1Z"/>',
  // Two chain links.
  link: '<path d="M10 14 14 10"/><path d="M8.5 11.5 6 14a3.2 3.2 0 0 0 4.5 4.5L13 16"/><path d="M11 8l2.5-2.5A3.2 3.2 0 0 1 18 10l-2.5 2.5"/>',
  // Person: head + shoulders.
  user: '<circle cx="12" cy="8.5" r="3.5"/><path d="M5 20c.6-3.8 3.4-6 7-6s6.4 2.2 7 6"/>',
  // Circle with a check.
  check: '<circle cx="12" cy="12" r="8.5"/><path d="m8.2 12.2 2.6 2.6 5-5.2"/>',
  // Euro sign.
  euro: '<path d="M17.5 6.4A6.8 6.8 0 0 0 7.2 9.6a7.3 7.3 0 0 0 0 4.8 6.8 6.8 0 0 0 10.3 3.2"/><path d="M4.5 10.2h9M4.5 13.8h9"/>',
  // Shield with a check.
  shield: '<path d="M12 3.5 19 6v5.5c0 4.4-3 7.7-7 9-4-1.3-7-4.6-7-9V6z"/><path d="m8.8 12 2.2 2.2 4.2-4.4"/>',
  // Two people.
  team: '<circle cx="8.5" cy="9" r="2.8"/><circle cx="16" cy="9" r="2.8"/><path d="M3.5 19c.5-3 2.4-4.8 5-4.8s4.5 1.8 5 4.8"/><path d="M13.5 15.2c.8-.7 1.6-1 2.5-1 2.6 0 4.5 1.8 5 4.8"/>',
  // Heart.
  heart: '<path d="M12 19.5s-7.5-4.4-7.5-10A4.2 4.2 0 0 1 12 7a4.2 4.2 0 0 1 7.5 2.5c0 5.6-7.5 10-7.5 10Z"/>',
  // Speech bubble.
  chat: '<path d="M4 5.5h16v11H10l-4 3.5v-3.5H4z"/><path d="M8 10h8M8 13h5"/>',
  // Price tag.
  tag: '<path d="M3.5 12.2 11.8 4H20v8.2l-8.3 8.3z"/><circle cx="15.6" cy="8.4" r="1.4"/>',
  // Stacked layers.
  layers: '<path d="m12 4 8.5 4.5L12 13 3.5 8.5z"/><path d="m3.5 12.5 8.5 4.5 8.5-4.5"/><path d="m3.5 16.3 8.5 4.2 8.5-4.2"/>',
  // A whole split into instalments.
  split: '<path d="M3.5 6h17v12h-17z"/><path d="M9.2 6v12M14.8 6v12"/><path d="M5.8 10.5h1.2M11.4 10.5h1.2M17 10.5h1.2"/>',
  // The one filled glyph: WhatsApp's own mark (same path as the site's
  // floating button), because a drawn lookalike reads as a fake.
  whatsapp:
    '<path fill="currentColor" stroke="none" d="M19.05 4.91A9.82 9.82 0 0 0 12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.2 4.74 1.2h.01c5.46 0 9.9-4.44 9.9-9.9 0-2.65-1.03-5.14-2.9-7.01zM12.04 20.15h-.01a8.2 8.2 0 0 1-4.18-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.18 8.18 0 0 1-1.26-4.38c0-4.54 3.7-8.23 8.24-8.23 2.2 0 4.27.86 5.82 2.42a8.18 8.18 0 0 1 2.42 5.82c0 4.54-3.7 8.24-8.24 8.24zm4.52-6.16c-.25-.12-1.47-.72-1.69-.8-.23-.09-.39-.13-.56.12-.16.25-.64.8-.78.97-.15.16-.29.18-.54.06-.25-.12-1.04-.38-1.99-1.22-.74-.66-1.23-1.47-1.38-1.71-.14-.25-.01-.38.11-.5.11-.11.25-.29.37-.43.12-.14.16-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.41-.42-.56-.42l-.47-.01c-.17 0-.43.06-.66.31-.23.25-.87.85-.87 2.07 0 1.22.89 2.4 1.01 2.56.12.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.15-1.18-.06-.1-.23-.16-.48-.29z"/>',
  telegram: '<path d="M3.5 11.5 20.5 4l-3 16-6-4.2"/><path d="m11.5 15.8-1 4.2-1.8-6 11.8-10"/>',
  mail: '<path d="M3.5 6h17v12h-17z"/><path d="m3.5 6.5 8.5 6.5 8.5-6.5"/>',
  share: '<path d="M12 3.5v12"/><path d="m7.5 8 4.5-4.5L16.5 8"/><path d="M5 12v8.5h14V12"/>',
  copy: '<path d="M8.5 8.5h11v11h-11z"/><path d="M15.5 8.5v-4h-11v11h4"/>',
  qr: '<path d="M4 4h6v6H4zM14 4h6v6h-6zM4 14h6v6H4z"/><path d="M14 14h2v2h-2zM18 14h2M14 18v2M17 17h3v3"/>',
  arrow: '<path d="M4 12h15"/><path d="m13 6 6 6-6 6"/>',
};
const body = paths[name];
---

<svg
  class:list={["icon", cls]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="square"
  stroke-linejoin="miter"
  role={label ? "img" : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : "true"}
  focusable="false"
  set:html={body}
/>
