---
/* Minimal, conversion-first header (the site's "campaign" chrome): the
   lockup and the flyer's strapline on the left; alpacode.it, the language
   switch and one CTA on the right. No navigation to leak visitors. */
import type { Lang } from "../i18n/types";
import { shared } from "../data/shared";
import { websiteLinks } from "../data/business";
import Lockup from "./Lockup.astro";

interface Props {
  lang: Lang;
  homeHref: string;
  altHref: string;
  ctaLabel: string;
  ctaHref: string;
}
const { lang, homeHref, altHref, ctaLabel, ctaHref } = Astro.props;
const c = shared[lang].header;
---

<header class="site-header">
  <div class="header-strut"></div>
  <div class="header-row">
    <div class="header-brand">
      <a class="brand" href={homeHref} aria-label="Alpacode · Soluzioni Digitali">
        <Lockup width={168} />
      </a>
      <p class="header-tagline">
        {c.tagline.map((l) => <span>{l}</span>)}
      </p>
    </div>
    <div class="nav-actions">
      <a class="header-site" href={websiteLinks.home[lang]}>
        {c.siteLink} <span class="arrow" aria-hidden="true">→</span>
      </a>
      <a class="header-lang" href={altHref} hreflang={lang === "it" ? "en" : "it"} lang={lang === "it" ? "en" : "it"}>
        <span class="visually-hidden">{c.langLabel}: </span>{c.langSwitch}
      </a>
      <a class="btn btn-blue btn-sm header-cta" href={ctaHref} data-header-cta>
        {ctaLabel} <span class="arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    -webkit-backdrop-filter: blur(14px) saturate(1.3);
    backdrop-filter: blur(14px) saturate(1.3);
    border-bottom: 1px solid transparent;
    transition:
      transform 0.6s var(--ease-expo),
      border-color 0.3s var(--ease);
  }
  .site-header:global(.scrolled) {
    border-bottom-color: var(--rule);
  }
  .site-header:global(.is-hidden) {
    transform: translateY(-100%);
  }
  .site-header:global(.is-hidden):focus-within {
    transform: none;
  }
  .header-strut {
    height: 4px;
    background: var(--blue);
  }
  .header-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    max-width: 1480px;
    margin: 0 auto;
    padding: 14px var(--gutter);
  }
  .header-brand {
    display: flex;
    align-items: center;
    gap: 28px;
    min-width: 0;
  }
  .brand {
    display: block;
    flex: none;
    padding: 2px 0;
  }
  .header-tagline {
    display: grid;
    gap: 1px;
    padding-left: 28px;
    border-left: 1px solid var(--rule);
    font-size: 13px;
    line-height: 1.35;
    font-weight: 500;
    color: var(--mute-2);
  }
  .nav-actions {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .header-site {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-right: 10px;
    padding: 6px 0;
    font-weight: 700;
    font-size: 15px;
    color: var(--blue-deep);
    background: linear-gradient(var(--blue), var(--blue)) 0 100% / 100% 2px no-repeat;
    transition: color 0.2s var(--ease);
  }
  .header-site:hover {
    color: var(--ink);
  }
  .header-site .arrow {
    transition: transform 0.45s var(--ease-expo);
  }
  .header-site:hover .arrow {
    transform: translateX(4px);
  }
  .header-lang {
    padding: 9px 12px;
    border: 1px solid var(--rule);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--ink);
    transition: border-color 0.2s var(--ease);
  }
  .header-lang:hover {
    border-color: var(--ink);
  }
  @media (max-width: 1080px) {
    .header-tagline {
      display: none;
    }
  }
  @media (max-width: 720px) {
    .header-row {
      padding-top: 10px;
      padding-bottom: 10px;
      gap: 12px;
    }
    .header-site {
      display: none;
    }
    .brand :global(.lockup) {
      width: 128px;
      height: auto;
    }
  }
  @media (max-width: 380px) {
    .header-cta {
      padding-left: 11px;
      padding-right: 11px;
    }
    .header-cta .arrow {
      display: none;
    }
  }
</style>
